#include <iostream>
using namespace std;
class operation
{
  private:
  int a,b,c;
  public:
  int add(int a,int b)
   {
      return a+b;
   }
   float add(float a,float b)
   {
     return a+b;
   }
   int add(int a,int b,int c)
  {
    return a+b+c;
  }
};

int main()
{
   operation op;
   cout << "Sum is:" << op.add(2,7) << endl;
   cout << "Sum is:" << op.add(5.4f,7.2f) <<endl;
  cout << "Sum is:" << op.add(2,9,8) <<endl;
  return 0;
}
